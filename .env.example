# LeadFlow Sync configuration. `python scripts/setup.py` copies this to .env
# (git-ignored) and fills in N8N_ENCRYPTION_KEY. Defaults point to the local sandbox.

# --- n8n runtime ---
N8N_PORT=5678
N8N_ENCRYPTION_KEY=

# --- CRM (HubSpot CRM v3 API) ---
# Real HubSpot: CRM_BASE_URL=https://api.hubapi.com and a private app token with
# crm.objects.contacts.read/write scopes. Run scripts/hubspot_properties.py once
# to create the custom leadflow_* contact properties.
CRM_BASE_URL=http://127.0.0.1:8787
HUBSPOT_TOKEN=sandbox-token
# Real HubSpot: https://app.hubspot.com/contacts/<portalId>/record/0-1/{id}
CRM_RECORD_URL=http://127.0.0.1:8787/#contact-{id}

# --- Slack incoming webhooks ---
SLACK_LEADS_WEBHOOK_URL=http://127.0.0.1:8787/slack/leads
SLACK_ALERTS_WEBHOOK_URL=http://127.0.0.1:8787/slack/alerts

# --- Run log ---
# Real Google Sheet: deploy sheets/apps_script.gs as a web app and paste its URL here.
LOG_URL=http://127.0.0.1:8787/log/rows

# --- Optional AI step (sends lead text to the Anthropic API) ---
LEADFLOW_AI=off
ANTHROPIC_API_KEY=
LEADFLOW_MODEL=claude-opus-5-5
